<button class="ui primary button" commandfor="initrepo" command="show-modal">初始化仓库</button>
<dialog id="initrepo"><h2>初始化仓库</h2><form method="post" action="{{AppSubUrl}}/-/delivery/create" class="ui form"><label>仓库名称<input name="name" required></label><label>仓库描述<input name="description"></label><label>开发分支<input name="development" value="dev" required></label><label>保护分支（逗号分隔）<input name="protected" value="main,uat" required></label><label>Agent 用户名<input name="agent"></label><label>Agent 编码约束<textarea name="instructions">通过 PR 提交变更</textarea></label><footer><button type="button" commandfor="initrepo" command="close">关闭</button><button class="ui primary button" name="op" value="init-repo">初始化仓库</button></footer></form></dialog>