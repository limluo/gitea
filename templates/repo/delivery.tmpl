{{template "base/head" .}}
<main class="page-content delivery-shell" data-tab="{{.DeliveryTab}}">
<aside class="delivery-sidebar"><div class="delivery-brand"><i class="delivery-mark" aria-hidden="true"></i>交付工作台</div><small>工作空间</small>
<nav aria-label="业务导航"><a href="?tab=overview" class="{{if eq .DeliveryTab "overview"}}selected{{end}}">{{svg "octicon-home"}} 交付总览</a>
{{if .CanBranches}}<a href="?tab=branches" class="{{if eq .DeliveryTab "branches"}}selected{{end}}">{{svg "octicon-git-branch"}} 需求与分支</a>{{end}}{{if .CanReview}}<a href="?tab=reviews" class="{{if eq .DeliveryTab "reviews"}}selected{{end}}">{{svg "octicon-git-pull-request"}} Agent 合并审批</a>{{end}}
{{if .Targets}}<a href="?tab=releases" class="{{if eq .DeliveryTab "releases"}}selected{{end}}">{{svg "octicon-rocket"}} 发版操作</a>{{end}}
{{if and .managesettings .TechView}}<a href="?tab=settings" class="{{if eq .DeliveryTab "settings"}}selected{{end}}">{{svg "octicon-repo"}} 仓库管理</a>{{end}}{{if and .manageenvironment .TechView}}<a href="?tab=environment" class="{{if eq .DeliveryTab "environment"}}selected{{end}}">{{svg "octicon-server"}} 部署环境</a>{{end}}{{if and .manageagents .TechView}}<a href="?tab=agents" class="{{if eq .DeliveryTab "agents"}}selected{{end}}">{{svg "octicon-key"}} MCP 管理及授权</a>{{end}}{{if and .manageusers .TechView}}<a href="?tab=users" class="{{if eq .DeliveryTab "users"}}selected{{end}}">{{svg "octicon-people"}} 用户管理</a>{{end}}</nav><a class="delivery-original" href="{{.RepoLink}}">{{svg "octicon-repo"}} 原生仓库</a></aside>
<div class="delivery-main"><header><span>研发工作空间　 /　 <b>{{.Crumb}}</b></span><select data-delivery-persona aria-label="工作角色"><option value="business">业务负责人 · {{.SignedUser.Name}}</option>{{if .TechRole}}<option value="tech" {{if .TechView}}selected{{end}}>技术负责人 · {{.SignedUser.Name}}</option>{{end}}</select></header><article>
{{template "base/alert" .}}
{{if eq .DeliveryTab "overview"}}
<div class="delivery-heading"><div><h1>交付总览</h1><p>查看待办事项、当前环境版本与最近交付记录。</p></div>{{template "repo/delivery_repo_select" .}}</div><div class="delivery-grid"><section class="ui segment"><h2>{{if .TechView}}专家复核{{else}}待我审批{{end}} <sup>{{.InboxCount}}</sup></h2>{{range .Inbox}}<a class="delivery-workitem" href="?tab=reviews&amp;pr={{.Index}}">{{svg "octicon-git-pull-request" 20}} <span><strong>{{.Title}}</strong><small>PR #{{.Index}} · {{$.Repository.Name}}</small></span></a>{{else}}<p>当前没有待办审批。</p>{{end}}{{if .CanReview}}<a href="?tab=reviews&amp;queue={{if $.TechView}}expert{{else}}pending{{end}}">审批队列 →</a>{{end}}</section>
<section class="ui segment delivery-environments"><h2>环境版本</h2>{{range .Versions}}<a class="delivery-tile" href="?tab=releases&amp;branch={{.Branch}}"><small>{{if eq .Branch "main"}}生产环境{{else if eq .Branch "uat"}}验收环境{{else}}部署环境{{end}}</small><strong>{{if .SHA}}{{printf "%.12s" .SHA}}{{else}}暂无部署记录{{end}}</strong><code>{{.Branch}}</code></a>{{else}}暂无可查看的环境{{end}}</section></div>
<section class="ui segment"><h2>交付动态</h2>{{range .Events}}<div class="delivery-event"><time>{{.CreatedAt}}</time><div><strong>{{.Subject}}</strong><small>{{.Actor}} · {{.Kind}} · {{.Branch}}</small>{{if .Detail}}<p>{{.Detail}}</p>{{end}}</div></div>{{else}}暂无操作记录。{{end}}</section>
{{else if eq .DeliveryTab "branches"}}
<div class="delivery-heading"><div><h1>需求与分支</h1><p>从业务需求建立开发分支，跟进变更交付进度。</p></div><div class="delivery-sigil" aria-hidden="true">{{svg "octicon-git-branch" 35}}</div></div><section class="ui segment">{{template "repo/delivery_repo_select" .}} {{if .CreateTask}}<button class="ui primary button" commandfor="create-feature" command="show-modal">新建需求分支</button><dialog id="create-feature"><h2>新建需求分支</h2><p>从 {{.Repository.Name}} 的 {{.DeliverySettings.Development}} 创建独立开发分支。</p><form method="post" class="ui form"><label>需求名称<input required name="title"></label><label>验收标准<textarea required name="criteria"></textarea></label><label>分支名称<input required name="feature" placeholder="feature/order-export"></label><footer><button type="button" commandfor="create-feature" command="close">关闭</button><button class="ui primary button" name="op" value="create-task">保存</button></footer></form></dialog>{{end}}
<h2>需求分支</h2><div class="ui secondary menu">{{range .Stages}}<a class="{{if eq .Value $.Stage}}active {{end}}item" href="?tab=branches&amp;stage={{.Value}}">{{.Name}} {{.Count}}</a>{{end}}</div><table class="ui table"><thead><tr><th>业务需求</th><th>开发分支</th><th>开发进度</th><th>操作</th></tr></thead><tbody>{{range $i,$t:=.Tasks}}<tr><td>{{.Title}}</td><td><code>{{.Branch}}</code></td><td>{{.State}}</td><td><button class="ui button" commandfor="task-{{$i}}" command="show-modal">分支详情</button>
<dialog id="task-{{$i}}"><h2>分支详情</h2><h3>{{.Title}}</h3><p>{{$.Repository.Name}} / <code>{{.Branch}}</code></p><p>基线分支　{{$.DeliverySettings.Development}} · {{.State}}</p><h3>验收标准</h3><p>{{.Criteria}}</p>{{if .Note}}<h3>修改要求</h3><p>{{.Note}}</p>{{end}}<h3>关联 PR</h3>{{range .PRs}}<p>{{if $.CanReview}}<a href="?tab=reviews&amp;pr={{.}}">PR #{{.}} · 前往审批记录</a>{{else}}PR #{{.}}{{end}}</p>{{else}}<p>提交开发成果后，审批记录会显示在这里。</p>{{end}}<button commandfor="task-{{$i}}" command="close">关闭</button></dialog>
{{if and $.CreateTask (or (eq .State "开发中") (eq .State "修改中"))}}<button class="ui button" commandfor="file-{{$i}}" command="show-modal">{{if eq .State "修改中"}}重新提交 PR{{else}}提交 PR{{end}}</button><dialog id="file-{{$i}}"><h2>提交业务确认</h2><p>{{.Title}}</p><p>{{.Branch}} → {{$.DeliverySettings.Development}}</p><form method="post"><input type="hidden" name="feature" value="{{.Branch}}"><button type="button" commandfor="file-{{$i}}" command="close">关闭</button><button class="ui primary button" name="op" value="submit-task">提交 PR</button></form></dialog>{{end}}</td></tr>{{end}}</tbody></table>{{if not .Tasks}}<p>暂无记录</p>{{end}}</section>
<section class="ui segment"><h2>长期维护分支</h2><table class="ui table"><thead><tr><th>分支</th><th>用途</th></tr></thead><tbody><tr><td>{{.DeliverySettings.Development}}</td><td>汇集已确认的业务变更</td></tr>{{range .Targets}}<tr><td>{{.}}</td><td>{{if eq . "main"}}生产发布{{else}}环境发布{{end}}</td></tr>{{end}}</tbody></table>{{if and .managesettings .TechView}}<a class="ui button" href="?tab=settings&amp;edit=1">设置保护分支</a>{{end}}</section>{{else if eq .DeliveryTab "reviews"}}
<div class="delivery-heading"><div><h1>Agent 合并审批</h1><p>确认 Agent 提交的业务变更，或交由专家复核。</p></div><div class="delivery-sigil" aria-hidden="true">{{svg "octicon-git-pull-request" 35}}</div></div><section class="ui segment"><h2>审批队列</h2><div class="ui secondary pointing menu"><a class="{{if eq .Queue "pending"}}active {{end}}item" href="?tab=reviews&amp;queue=pending">待我审批</a><a class="{{if eq .Queue "expert"}}active {{end}}item" href="?tab=reviews&amp;queue=expert">专家复核</a><a class="{{if eq .Queue "done"}}active {{end}}item" href="?tab=reviews&amp;queue=done">已处理</a></div>
{{if .Pulls}}<table class="ui table"><thead><tr><th>业务变更</th><th>目标分支</th><th>状态</th><th>操作</th></tr></thead><tbody>{{range .Pulls}}<tr><td><strong>{{.Title}}</strong><br><small>#{{.Number}} · {{$.Repository.Name}}</small></td><td><code>{{$.DeliverySettings.Development}}</code></td><td>{{.State}}</td><td><button class="ui small button" commandfor="review-{{.Number}}" command="show-modal">{{if eq $.Queue "done"}}查看{{else}}处理{{end}}</button>
<dialog id="review-{{.Number}}" {{if and $.OpenPR (eq $.OpenPR .Number)}}data-delivery-open{{end}}><h2>PR #{{.Number}} · {{.Title}}</h2><h3>业务目标与验收标准</h3><p>{{.Description}}</p><button class="ui button" data-delivery-diff="{{$.RepoLink}}/pulls/{{.Number}}.diff">查看代码差异</button><p>当前状态　{{.State}}</p>{{if .History}}<h3>审批记录</h3>{{range .History}}<p>{{.Actor}} · {{.Kind}} {{.Detail}}</p>{{end}}{{end}}
<form method="post" class="ui form" data-review-form><input type="hidden" name="number" value="{{.Number}}"><input type="hidden" name="head" value="{{.Head}}">
{{if and .Head (ne $.Queue "done") (or (eq $.Queue "pending") .Mine) (or $.merge $.reject $.expert)}}<label>处理方式<select name="op" required>{{if eq $.Queue "pending"}}{{if $.merge}}<option value="merge">确认并合并</option>{{end}}{{if $.expert}}<option value="expert">转交专家</option>{{end}}{{else if $.expert}}<option value="return">审查通过，交还业务确认</option>{{end}}{{if $.reject}}<option value="revise">要求修改</option><option value="reject">驳回</option>{{end}}</select></label><label data-review-expert>专家用户名<input name="expert"></label><label>处理意见<textarea name="note" placeholder="要求修改或驳回时，请写明原因"></textarea></label><footer><button type="button" commandfor="review-{{.Number}}" command="close">关闭</button><button class="ui primary button">提交结论</button></footer>{{else}}<button type="button" commandfor="review-{{.Number}}" command="close">关闭</button>{{end}}</form></dialog></td></tr>{{end}}</tbody></table>{{else}}<div class="delivery-empty"><span>{{svg "octicon-git-pull-request" 30}}</span><h3>{{if eq .Queue "pending"}}暂无待审批变更{{else if eq .Queue "expert"}}暂无专家复核任务{{else}}暂无已处理记录{{end}}</h3><p>{{if eq .Queue "pending"}}Agent 发起的待审 PR 会出现在这里。{{else if eq .Queue "expert"}}业务人员转交的 PR 会出现在这里。{{else}}完成处理后，可以在这里回看审批记录。{{end}}</p></div>{{end}}</section>{{else if eq .DeliveryTab "releases"}}
 <div class="delivery-heading"><div><h1>发版操作</h1><p>选择变更发布至目标环境，跟踪验收与运行版本。</p></div><div class="delivery-sigil" aria-hidden="true">{{svg "octicon-rocket" 35}}</div></div>{{template "repo/delivery_repo_select" .}}<div class="delivery-grid"><section class="ui segment"><h3>生产当前版本</h3><strong>{{if .Production}}{{printf "%.12s" .Production}}{{else}}暂无成功部署记录{{end}}</strong></section><section class="ui segment"><h3>{{.Target}} 当前部署版本</h3><strong>{{if .Deployed}}{{printf "%.12s" .Deployed}}{{else}}暂无成功部署记录{{end}}</strong></section></div><div class="ui secondary menu tw-flex-wrap">{{range .Targets}}<a class="{{if eq . $.Target}}active {{end}}item" href="?tab=releases&amp;branch={{.}}">{{.}}</a>{{end}}</div>
 <section class="ui segment"><h2>{{.Target}} 环境</h2><div>分支当前版本　<code>{{.TargetHead}}</code></div><div>最近部署成功版本　{{if .Deployed}}<code>{{.Deployed}}</code>{{else}}暂无成功部署记录{{end}}</div><a href="{{.RepoLink}}/actions">查看流水线</a></section>

 <table class="ui unstackable table"><thead><tr><th>可发布变更</th><th>目标环境状态</th><th>业务验收</th><th>下一步</th></tr></thead><tbody>
 {{range .Changes}}<tr><td>{{.Title}}<div>PR #{{.Number}} · <a href="{{$.RepoLink}}/commit/{{.SHA}}"><code>{{printf "%.10s" .SHA}}</code></a></div></td><td>{{.Status}}</td><td>{{if .Acceptance}}{{.Acceptance}} {{.Feedback}}{{else}}待验收{{end}}</td><td>
 <form method="post"><input type="hidden" name="head" value="{{$.TargetHead}}"><input type="hidden" name="sha" value="{{.SHA}}"><input type="hidden" name="applied" value="{{.Applied}}"><input type="hidden" name="branch" value="{{$.Target}}">
 {{if and (eq .Status "已合并 · 已部署") (ne .Acceptance "验收通过") $.publish (eq $.Target "uat")}}<button type="button" class="ui primary button" commandfor="accept-{{.SHA}}" command="show-modal">登记验收</button><dialog id="accept-{{.SHA}}"><h2>登记 UAT 验收</h2><h3>{{.Title}}</h3><label>验收结果</label><select name="result"><option>验收通过</option><option>验收未通过</option></select><input name="note" placeholder="验收记录"><button name="op" value="accept" class="ui button">保存验收结论</button><button type="button" commandfor="accept-{{.SHA}}" command="close">关闭</button></dialog>{{end}}{{if .Applied}}{{if $.revoke}}<button type="button" class="ui small button" commandfor="confirm-{{.SHA}}" command="show-modal">撤销发版</button><dialog id="confirm-{{.SHA}}"><h2>撤销单项变更</h2><p>{{.Title}}</p><p>{{$.Repository.FullName}} / <strong>{{$.Target}}</strong></p><code>{{.SHA}}</code><p>本次操作会更新目标分支并按环境配置触发流水线。</p><button type="button" class="ui button" commandfor="confirm-{{.SHA}}" command="close">取消</button><button class="ui primary button" name="op" value="revoke">确认撤销发版</button></dialog>{{end}}{{else if and .Blocked (not .Common)}}等待 UAT 验收{{else if and $.publish (not .Common)}}<button type="button" class="ui small primary button" commandfor="confirm-{{.SHA}}" command="show-modal">合并发版</button><dialog id="confirm-{{.SHA}}"><h2>确认发布</h2><p>{{.Title}}</p><p>{{$.Repository.FullName}} / <strong>{{$.Target}}</strong></p><code>{{.SHA}}</code><p>本次操作会更新目标分支并按环境配置触发流水线。</p><button type="button" class="ui button" commandfor="confirm-{{.SHA}}" command="close">取消</button><button class="ui primary button" name="op" value="publish">确认合并发版</button></dialog>{{end}}</form></td></tr>{{end}}
 </tbody></table>
 {{else if eq .DeliveryTab "settings"}}
 <div class="delivery-heading"><div><h1>仓库管理</h1><p>维护开发分支、保护规则与 Agent 编码约束。</p></div><div class="delivery-sigil" aria-hidden="true">{{svg "octicon-repo" 35}}</div></div><section class="ui segment">{{if .DeliveryAdmin}}{{template "repo/delivery_init" .}}{{end}}
<h2>仓库列表</h2><table class="ui table"><thead><tr><th>仓库名称</th><th>保护分支</th><th>操作</th></tr></thead><tbody>{{range .WorkspaceRepos}}<tr><td>{{.Name}}</td><td>{{.Protected}}</td><td><button class="ui button" commandfor="repo-{{.ID}}" command="show-modal">设置</button><dialog id="repo-{{.ID}}" {{if and $.EditRepo (eq .ID $.Repository.ID)}}data-delivery-open{{end}}><h2>仓库设置</h2><p>{{.Name}}</p><form class="ui form" method="post" action="{{.Link}}/delivery"><input type="hidden" name="original" value="{{.Exact}}"><label>仓库描述<input name="description" value="{{.Description}}"></label><label>开发分支<input required name="development" value="{{.Dev}}"></label><label>保护分支（逗号分隔）<input required name="protected" value="{{.Exact}}"></label><label>Agent 用户名<input name="agent" value="{{.Agent}}"></label><label>Agent 编码约束<textarea name="instructions">{{.Prompt}}</textarea></label><p><a href="{{.Link}}/settings/branches">高级保护规则</a></p><footer><button type="button" commandfor="repo-{{.ID}}" command="close">关闭</button><button class="ui primary button" name="op" value="save-repo">保存</button></footer></form></dialog></td></tr>{{end}}</tbody></table></section>{{else if eq .DeliveryTab "users"}}
 <div class="delivery-heading"><div><h1>用户管理</h1><p>按成员和分支维护可见菜单与操作权限。</p></div><div class="delivery-sigil" aria-hidden="true">{{svg "octicon-people" 35}}</div></div><p><a href="{{AppSubUrl}}/-/admin/users">管理站点用户</a> · <a href="{{.RepoLink}}/settings/collaboration">管理仓库成员</a></p>
 <section class="ui segment"><table class="ui table"><thead><tr><th>用户</th><th>授权范围</th><th>操作</th></tr></thead><tbody>{{range .Accounts}}<tr><td>{{.Name}}</td><td>{{$.Repository.FullName}} {{ $name := .Name }}{{range $.Grants}}{{if eq .Login $name}} / <a href="?tab=users&amp;user={{.Login}}&amp;scope={{.Branch}}">{{.Branch}}</a>{{end}}{{end}}</td><td><a class="ui button" href="?tab=users&amp;user={{.Name}}&amp;scope={{$.DeliverySettings.Development}}">配置权限</a></td></tr>{{end}}</tbody></table><button commandfor="permissions" command="show-modal" class="ui button">按用户名授权</button></section><dialog id="permissions" {{if .EditLogin}}data-delivery-open{{end}}><h2>权限设置</h2><form class="ui form" method="post"><div class="two fields"><label class="field">用户名<input name="login" list="delivery-accounts" value="{{.EditLogin}}" required></label><label class="field">授权分支<input name="branch" value="{{.EditBranch}}" required placeholder="develop、uat、main 或 *"></label></div>
 <datalist id="delivery-accounts">{{range .Accounts}}<option value="{{.Name}}"></option>{{end}}</datalist><fieldset><legend>可见菜单</legend><div class="tw-flex tw-flex-wrap tw-gap-3">
 <label><input type="checkbox" name="buttons" value="review-view" {{if index .SelectedButtons "review-view"}}checked{{end}}> 审批列表</label><label><input type="checkbox" name="buttons" value="branches" {{if index .SelectedButtons "branches"}}checked{{end}}> 需求与分支</label><label><input type="checkbox" name="buttons" value="release-view" {{if index .SelectedButtons "release-view"}}checked{{end}}> 发版操作</label>
{{range $k,$name := .ManagementMenus}}<label><input type="checkbox" name="buttons" value="{{$k}}" {{if index $.SelectedButtons $k}}checked{{end}}> {{$name}}</label>{{end}}</div></fieldset><fieldset><legend>可用按钮</legend><div class="tw-flex tw-flex-wrap tw-gap-3"><label><input type="checkbox" name="buttons" value="task" {{if index .SelectedButtons "task"}}checked{{end}}> 创建需求分支</label><label><input type="checkbox" name="buttons" value="merge" {{if index .SelectedButtons "merge"}}checked{{end}}> 合并</label><label><input type="checkbox" name="buttons" value="reject" {{if index .SelectedButtons "reject"}}checked{{end}}> 驳回</label><label><input type="checkbox" name="buttons" value="expert" {{if index .SelectedButtons "expert"}}checked{{end}}> 邀请专家</label><label><input type="checkbox" name="buttons" value="publish" {{if index .SelectedButtons "publish"}}checked{{end}}> 发版</label><label><input type="checkbox" name="buttons" value="revoke" {{if index .SelectedButtons "revoke"}}checked{{end}}> 撤销</label></div></fieldset>
 <input type="hidden" name="scoped" value="true"><fieldset><legend>分支操作</legend>{{range $k,$name := .BranchOps}}<label><input type="checkbox" name="buttons" value="{{$k}}" {{if index $.SelectedButtons $k}}checked{{end}}> {{$name}}</label>{{end}}</fieldset><p>管理菜单适用于已具备原生仓库管理权限的成员，授权分支填写 *。</p><p>保存会替换该用户在此分支的授权。清空选项可撤销该条授权。</p><button class="ui primary button" name="op" value="grant">保存授权</button><button type="button" commandfor="permissions" command="close">关闭</button></form></dialog>
 <table class="ui table"><thead><tr><th>用户名</th><th>分支</th><th>已授予操作</th></tr></thead><tbody>{{range .Grants}}<tr><td>{{.Login}}</td><td>{{.Branch}}</td><td>{{.Buttons}}　<a href="?tab=users&amp;user={{.Login}}&amp;scope={{.Branch}}">配置权限</a></td></tr>{{end}}</tbody></table>
 {{else if eq .DeliveryTab "agents"}}
 <div class="delivery-heading"><div><h1>MCP 管理及授权</h1><p>管理 Agent 可调用的工具和仓库访问凭据。</p></div><div class="delivery-sigil" aria-hidden="true">{{svg "octicon-key" 35}}</div></div><section class="ui segment"><h2>工具授权</h2><button class="ui primary button" commandfor="grant-tools" command="show-modal">添加 MCP 授权</button><dialog id="grant-tools"><h2>添加工具授权</h2><form method="post" class="ui form"><label>服务名称<input name="service" required></label><label>Agent 用户名<input name="agent" required value="{{.AgentName}}"></label><label><input type="checkbox" name="tools" value="coding_instructions"> 读取编码约束</label><label><input type="checkbox" name="tools" value="repository_info"> 查询仓库信息</label><button class="ui primary button" name="op" value="tool-grant">创建授权</button><button class="ui button" type="button" commandfor="grant-tools" command="close">关闭</button></form></dialog>
<table class="ui table"><thead><tr><th>服务</th><th>Agent / 仓库</th><th>工具范围</th><th>操作</th></tr></thead><tbody>{{range .ToolGrants}}<tr><td>{{.Service}}</td><td>{{.Login}} / {{$.Repository.Name}}</td><td>{{.Tools}}</td><td><form method="post"><input type="hidden" name="mode" value="revoke"><input type="hidden" name="grant" value="{{.ID}}"><button class="ui button" name="op" value="tool-grant">撤销</button></form></td></tr>{{end}}</tbody></table></section>{{if .NewKey}}<p>请立即复制，此密钥仅显示一次。</p><code>{{.NewKey}}</code>{{end}}<h2>默认 Agent 授权</h2><section class="ui segment"><p>工作台 MCP 提供当前仓库的编码约束和目标开发分支。配置下方地址和 Bearer 密钥。</p><code>{{.MCPURL}}</code>
 {{if .AgentName}}<p>已绑定账号 <strong>{{.AgentName}}</strong> · <a href="{{AppSubUrl}}/-/admin/users/{{.DeliverySettings.AgentID}}">管理原生 Agent 账号与令牌</a></p>
 <form method="post"><input type="hidden" name="op" value="mcp-key"><button class="ui primary button" name="mode" value="issue">生成或轮换密钥</button><button class="ui button" name="mode" value="revoke">撤销密钥</button></form>

 {{else}}<a href="?tab=settings">先绑定 Agent 账号</a>{{end}}</section>
 {{else if eq .DeliveryTab "environment"}}
 <div class="delivery-heading"><div><h1>部署环境</h1><p>维护环境目标、连接凭据与部署任务。</p></div><div class="delivery-sigil" aria-hidden="true">{{svg "octicon-server" 35}}</div></div><section class="ui segment">{{template "repo/delivery_repo_select" .}}<table class="ui table"><thead><tr><th>保护分支</th><th>目标环境</th><th>云平台</th><th>操作</th></tr></thead><tbody>
{{range $i,$e:=.Environments}}<tr><td><code>{{$e.Branch}}</code></td><td>{{$e.Name}}</td><td>{{or $e.Cloud "未配置"}}</td><td><button class="ui button" commandfor="env-{{$i}}" command="show-modal">配置部署</button>
<dialog class="delivery-env-dialog" id="env-{{$i}}"><h2>部署配置 · {{$e.Branch}}</h2><form method="post" class="ui form"><input type="hidden" name="branch" value="{{$e.Branch}}">
<fieldset><legend>目标环境</legend><div class="two fields"><label class="field">环境名称<input name="name" value="{{$e.Name}}" required></label><label class="field">云平台<select name="cloud">{{if $e.Cloud}}<option>{{$e.Cloud}}</option>{{end}}<option>腾讯云</option><option>阿里云</option><option>自建环境</option></select></label></div><label>地域<input name="region" value="{{$e.Region}}"></label><label>目标主机 / IP<input required name="DEPLOY_HOST" value="{{$e.Values.DEPLOY_HOST}}"></label></fieldset>
<fieldset><legend>SSH 连接</legend><div class="two fields"><label class="field">端口<input type="number" min="1" max="65535" name="DEPLOY_PORT" value="{{or $e.Values.DEPLOY_PORT "22"}}"></label><label class="field">部署用户<input name="DEPLOY_USER" required value="{{$e.Values.DEPLOY_USER}}"></label></div><label>环境私钥 Secret 名称<input name="DEPLOY_KEY_ALIAS" value="{{or $e.Values.DEPLOY_KEY_ALIAS "DEPLOY_SSH_KEY"}}" placeholder="DEPLOY_KEY_UAT"></label><label>SSH 私钥<textarea name="DEPLOY_SSH_KEY" rows="2" placeholder="已配置时留空可沿用密钥"></textarea></label><label>已核验的 known_hosts<textarea required name="DEPLOY_KNOWN_HOSTS" rows="2">{{$e.Values.DEPLOY_KNOWN_HOSTS}}</textarea></label><label>部署目录<input name="DEPLOY_DIR" value="{{$e.Values.DEPLOY_DIR}}" placeholder="/srv/business-site/uat"></label></fieldset>
<fieldset><legend>部署任务</legend><label>触发方式<select name="trigger"><option value="push">分支推送</option><option value="workflow_dispatch" {{if eq $e.Event "workflow_dispatch"}}selected{{end}}>手动触发</option></select></label><label>Actions 工作流文件<input required name="workflow" value="{{$e.Workflow}}"></label><label>制品相对路径<input name="DEPLOY_ARTIFACT" value="{{$e.Values.DEPLOY_ARTIFACT}}" placeholder="默认使用仓库根目录"></label><label>部署超时（秒）<input type="number" min="1" max="86400" name="DEPLOY_TIMEOUT" value="{{or $e.Values.DEPLOY_TIMEOUT "300"}}"></label><label>健康检查路径<input name="DEPLOY_HEALTH" value="{{$e.Values.DEPLOY_HEALTH}}" placeholder="/health"></label></fieldset><footer><button type="button" class="ui button" commandfor="env-{{$i}}" command="close">关闭</button><button class="ui primary button" name="op" value="environment">保存配置</button></footer></form></dialog></td></tr>{{else}}<tr><td colspan="4">请先配置环境保护分支。</td></tr>{{end}}</tbody></table></section> {{end}}
 <div class="tw-flex tw-gap-3">{{if .Prev}}<a href="?tab={{.DeliveryTab}}&amp;branch={{.Target}}&amp;queue={{.Queue}}&amp;page={{.Prev}}">上一页</a>{{end}}{{if .Next}}<a href="?tab={{.DeliveryTab}}&amp;branch={{.Target}}&amp;queue={{.Queue}}&amp;page={{.Next}}">下一页</a>{{end}}</div>
 </article></div></main>
{{template "base/footer" .}}
