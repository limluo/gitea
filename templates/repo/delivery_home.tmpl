{{template "base/head" .}}
<main class="page-content delivery-shell delivery-picker"><aside class="delivery-sidebar"><div class="delivery-brand"><i class="delivery-mark" aria-hidden="true"></i>交付工作台</div><small>工作空间</small><nav><a class="selected" href="{{AppSubUrl}}/-/delivery">{{svg "octicon-repo"}} 我的业务仓库</a></nav><a class="delivery-original" href="{{AppSubUrl}}/">返回 Gitea</a></aside><div class="delivery-main"><article>
{{template "base/alert" .}}<div class="delivery-heading"><div><h1>业务工作空间</h1><p>选择仓库，继续需求开发、审批或发版。</p></div><div class="delivery-sigil">{{svg "octicon-repo" 35}}</div></div><div class="flex-between"><h2>我的业务仓库</h2>{{if .SignedUser.IsAdmin}}{{template "repo/delivery_init" .}}{{end}}</div>
<div class="ui divided items">{{range .DeliveryRepos}}
<div class="item"><div class="content"><a class="header" href="{{.Link}}/delivery">{{svg "octicon-repo"}} {{.FullName}}</a>{{if .Description}}<p>{{.Description}}</p>{{end}}</div><a class="ui button" href="{{.Link}}/delivery">进入交付</a></div>
{{else}}<div class="ui segment">暂无可操作的仓库。管理员可以在仓库的业务交付页分配权限。</div>{{end}}</div>
{{if .Prev}}<a href="?page={{.Prev}}">上一页</a>{{end}} {{if .Next}}<a href="?page={{.Next}}">下一页</a>{{end}}
</article></div></main>{{template "base/footer" .}}
